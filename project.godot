; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Phagocyte"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/GameManager.cs"
AchievementManager="*res://scripts/core/AchievementManager.cs"
SettingsManager="*res://scripts/core/SettingsManager.cs"
RunRecordManager="*res://scripts/core/RunRecordManager.cs"
DamageNumberSpawner="*res://scripts/ui/DamageNumberSpawner.cs"
AudioManager="*res://scripts/core/AudioManager.cs"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Phagocyte"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/BodyFont.tres"

