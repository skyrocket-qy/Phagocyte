theme_override_font_sizes/font_size = 11
text = "等级: 1/5 • 冷却: 3.2s"

[node name="HSeparator" type="HSeparator" parent="SkillTooltip/VBox"]
layout_mode = 2

[node name="TooltipDesc" type="Label" parent="SkillTooltip/VBox"]
