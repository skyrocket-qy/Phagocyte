theme_override_constants/separation = 14

[node name="Title" type="Label" parent="PauseModal/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 1)
theme_override_font_sizes/font_size = 22
text = "⏸ 免疫战斗暂停"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="PauseModal/VBox"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "▶ 继续战斗"

[node name="SettingsButton" type="Button" parent="PauseModal/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "⚙️ 系統設定"

[node name="ManualButton" type="Button" parent="PauseModal/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "📖 档案馆与技能手册"

[node name="RestartButton" type="Button" parent="PauseModal/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "🔄 重新开始"

[node name="MenuButton" type="Button" parent="PauseModal/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "🏠 返回主菜单"

[node name="SkillTooltip" type="PanelContainer" parent="."]
visible = false
z_index = 25
custom_minimum_size = Vector2(300, 0)
offset_left = 0.0
offset_top = 0.0
offset_right = 300.0
offset_bottom = 120.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_tooltip")

[node name="VBox" type="VBoxContainer" parent="SkillTooltip"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HeaderHBox" type="HBoxContainer" parent="SkillTooltip/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TooltipIcon" type="Label" parent="SkillTooltip/VBox/HeaderHBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "🦠"

[node name="TooltipTitle" type="Label" parent="SkillTooltip/VBox/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.4, 0.9, 0.8, 1)
theme_override_font_sizes/font_size = 14
text = "阿米巴伪足变形"

[node name="TooltipBadge" type="Label" parent="SkillTooltip/VBox/HeaderHBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 11
text = "[ 固有专属 ]"

[node name="TooltipStats" type="Label" parent="SkillTooltip/VBox"]
layout_mode = 2
