[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/CodexModal.cs" id="1_codex"]
[ext_resource type="Font" path="res://assets/fonts/BodyMediumFont.tres" id="3_btn_font"]
[ext_resource type="Shader" path="res://shaders/codex_grid_bg.gdshader" id="4_grid_shader"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_grid"]
shader = ExtResource("4_grid_shader")

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_modal"]
bg_color = Color(0.03, 0.06, 0.1, 1)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
content_margin_left = 36.0
content_margin_top = 24.0
content_margin_right = 36.0
content_margin_bottom = 24.0

[sub_resource type="StyleBoxLine" id="StyleBoxLine_sep"]
color = Color(0, 0.9, 1, 0.25)
thickness = 1

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_detail"]
bg_color = Color(0.07, 0.12, 0.18, 0.88)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2, 0.4, 0.55, 0.8)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 18.0
content_margin_top = 16.0
content_margin_right = 18.0
content_margin_bottom = 16.0

[node name="CodexModal" type="PanelContainer"]
z_index = 30
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_modal")
script = ExtResource("1_codex")

[node name="GridBg" type="ColorRect" parent="."]
layout_mode = 2
mouse_filter = 2
material = SubResource("ShaderMaterial_grid")
color = Color(0, 0, 0, 0)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.4, 0.85, 0.95, 1)
theme_override_font_sizes/font_size = 20
text = "微观档案馆与免疫手册"

[node name="CloseButton" type="Button" parent="VBox/Header"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.94, 0.99, 0.98, 1)
theme_override_colors/font_hover_color = Color(0.39, 1, 0.85, 1)
theme_override_fonts/font = ExtResource("3_btn_font")
theme_override_font_sizes/font_size = 14
text = "返回"

[node name="TabBar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SkillsTab" type="Button" parent="VBox/TabBar"]
