[node name="Content" type="Label" parent="CodexModal/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 13
text = "欢迎查阅人体防御系统微观档案：

• 巨噬细胞 (Macrophage)：先天免疫核心，能以阿米巴伪足吞噬入侵病原体，并透过溶酶体进行降解。
• 呼吸爆发 (Respiratory Burst)：白血球吞噬大量抗原后激活 NADPH 氧化酶，产生大量活性氧 (ROS) 杀灭病原。
• 金黄色葡萄球菌 (Staph)：常驻于表皮，破裂创口入侵后易抱团形成葡萄状簇抵御免疫识别。

更多冷冻电镜 (Cryo-EM) 结构与病原体数据库即将陆续上线！"
autowrap_mode = 3

