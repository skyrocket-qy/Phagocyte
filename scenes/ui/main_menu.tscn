[node name="Content" type="Label" parent="CodexModal/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 13
text = "歡迎查閱人體防禦系統微觀檔案：

• 巨噬細胞 (Macrophage)：先天免疫核心，能以阿米巴偽足吞噬入侵病原體，並透過溶酶體進行降解。
• 呼吸爆發 (Respiratory Burst)：白血球吞噬大量抗原後激活 NADPH 氧化酶，產生大量活性氧 (ROS) 殺滅病原。
• 金黃色葡萄球菌 (Staph)：常駐於表皮，破裂創口入侵後易抱團形成葡萄狀簇抵禦免疫識別。

更多冷凍電鏡 (Cryo-EM) 結構與病原體數據庫即將陸續上線！"
autowrap_mode = 3

[node name="CloseButton" type="Button" parent="CodexModal/VBox"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
size_flags_horizontal = 4
text = "關閉檔案"
